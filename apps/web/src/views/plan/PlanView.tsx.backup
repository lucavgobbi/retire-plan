import { useEffect, useRef, useState, type FormEvent, type ReactNode } from "react";
import type {
  AccountPlan,
  AssetPlan,
  DebtPlan,
  ExpensePlan,
  IncomePlan,
  SavingsPolicyStep,
  SavingsTarget,
} from "@budgettool/engine";
import { calculateCurrentAge, useWorkspace } from "../../store/api";
import "./planView.css";

type Tab = "Profile" | "Accounts" | "Assets & debts" | "Income" | "Expenses" | "Savings";
const TABS: Tab[] = ["Profile", "Accounts", "Assets & debts", "Income", "Expenses", "Savings"];

function makeId(prefix: string): string {
  return typeof crypto !== "undefined" && "randomUUID" in crypto
    ? `${prefix}-${crypto.randomUUID()}`
    : `${prefix}-${Date.now()}`;
}

function TextInput({ label, value, onChange, step, min, optional = false }: {
  label: string; value: string; onChange: (value: string) => void; step?: string; min?: string; optional?: boolean;
}) {
  return <label className="plan-field"><span className="field-label">{label}{optional && <span className="plan-optional"> · optional</span>}</span>
    <input type="number" inputMode="decimal" step={step ?? "any"} min={min} value={value}
      onChange={event => onChange(event.currentTarget.value)} />
  </label>;
}

function TextField({ label, value, onChange, placeholder }: {
  label: string; value: string; onChange: (value: string) => void; placeholder?: string;
}) {
  return <label className="plan-field"><span className="field-label">{label}</span><input type="text" value={value} placeholder={placeholder}
    onChange={event => onChange(event.currentTarget.value)} /></label>;
}

function SelectField<T extends string>({ label, value, choices, onChange, labels }: {
  label: string; value: T; choices: readonly T[]; onChange: (value: T) => void; labels?: Record<T, string>;
}) {
  return <label className="plan-field"><span className="field-label">{label}</span><select value={value} onChange={event => onChange(event.currentTarget.value as T)}>
    {choices.map(choice => <option key={choice} value={choice}>{labels?.[choice] ?? choice}</option>)}
  </select></label>;
}

function requiredNumber(raw: string, label: string, errors: string[], minimum?: number): number {
  if (raw.trim() === "") { errors.push(`${label} is required.`); return 0; }
  const value = Number(raw);
  if (!Number.isFinite(value)) { errors.push(`${label} must be a finite number.`); return 0; }
  if (minimum !== undefined && value < minimum) errors.push(`${label} must be at least ${minimum}.`);
  return value;
}

function optionalNumber(raw: string, label: string, errors: string[], minimum?: number): number | undefined {
  if (raw.trim() === "") return undefined;
  return requiredNumber(raw, label, errors, minimum);
}

function requiredInteger(raw: string, label: string, errors: string[], minimum?: number): number {
  const value = requiredNumber(raw, label, errors, minimum);
  if (Number.isFinite(value) && !Number.isInteger(value)) errors.push(`${label} must be a whole number.`);
  return value;
}

function optionalInteger(raw: string, label: string, errors: string[], minimum?: number): number | undefined {
  if (raw.trim() === "") return undefined;
  return requiredInteger(raw, label, errors, minimum);
}

function ErrorList({ errors }: { errors: string[] }) {
  if (!errors.length) return null;
  return <div className="plan-errors" role="alert">{errors.map(error => <p key={error}>{error}</p>)}</div>;
}

function ItemForm({ title, children, errors, onSubmit, onRemove, onCancel, isNew = false }: {
  title: string; children: ReactNode; errors: string[]; onSubmit: () => void; onRemove?: () => void; onCancel?: () => void; isNew?: boolean;
}) {
  const [dirty, setDirty] = useState(false);
  const submit = (event: FormEvent) => { event.preventDefault(); if (!errors.length) { onSubmit(); setDirty(false); } };
  return <form className="plan-item-form" noValidate onSubmit={submit} onChangeCapture={() => setDirty(true)}>
    <div className="plan-item-heading"><h3>{title}</h3>{!isNew && <button type="button" className="plan-remove" onClick={onRemove}>Remove</button>}</div>
    <div className="plan-fields">{children}</div>
    <ErrorList errors={errors} />
    {dirty && <p className="draft-notice" role="status">Unsaved item edits. {isNew ? "Add item" : "Save changes"} to apply them.</p>}
    <div className="plan-actions"><button className="primary" type="submit" disabled={errors.length > 0}>{isNew ? "Add item" : "Save changes"}</button>
      {onCancel && <button type="button" onClick={onCancel}>Cancel</button>}</div>
  </form>;
}

interface AccountDraft { id: string; type: AccountPlan["type"]; balance: string; bookValue: string; equity: string; bond: string; cash: string }
const ACCOUNT_LABELS: Record<AccountPlan["type"], string> = { tfsa: "TFSA", rrsp: "RRSP", nonreg: "Non-registered" };
function accountDraft(account: AccountPlan): AccountDraft {
  return { id: account.id, type: account.type, balance: String(account.balance), bookValue: account.bookValue === undefined ? "" : String(account.bookValue), equity: String(account.assetMix.equity * 100), bond: String(account.assetMix.bond * 100), cash: String(account.assetMix.cash * 100) };
}
function readAccountDraft(draft: AccountDraft): { errors: string[]; item: AccountPlan } {
  const errors: string[] = [];
  const balance = requiredNumber(draft.balance, "Balance", errors, 0);
  const bookValue = draft.type === "nonreg" ? optionalNumber(draft.bookValue, "ACB / book value", errors, 0) : undefined;
  const equity = requiredNumber(draft.equity, "Equity allocation", errors, 0);
  const bond = requiredNumber(draft.bond, "Bond allocation", errors, 0);
  const cash = requiredNumber(draft.cash, "Cash allocation", errors, 0);
  if (Math.abs(equity + bond + cash - 100) > 0.1) errors.push("Asset mix must total 100%.");
  return { errors, item: { id: draft.id, type: draft.type, balance, bookValue, assetMix: { equity: equity / 100, bond: bond / 100, cash: cash / 100 } } };
}

function AccountForm({ account, onApply, onRemove }: { account: AccountPlan; onApply: (item: AccountPlan) => void; onRemove: () => void }) {
  const [draft, setDraft] = useState(() => accountDraft(account));
  const [applied, setApplied] = useState(false);
  const lastApplied = useRef(JSON.stringify(accountDraft(account)));
  useEffect(() => {
    const current = JSON.stringify(accountDraft(account));
    if (current !== lastApplied.current) {
      setDraft(accountDraft(account));
      lastApplied.current = current;
      setApplied(false);
    }
  }, [account]);
  const { errors } = readAccountDraft(draft);
  const change = (patch: Partial<AccountDraft>) => {
    const next = { ...draft, ...patch };
    setDraft(next);
    const parsed = readAccountDraft(next);
    if (parsed.errors.length > 0) { setApplied(false); return; }
    // Compare normalized values so typing "100." keeps its caret and text while
    // the stored value remains 100; returning to a valid draft needs no Save click.
    const normalized = JSON.stringify(accountDraft(parsed.item));
    if (normalized !== lastApplied.current) {
      lastApplied.current = normalized;
      onApply(parsed.item);
    }
    setApplied(true);
  };
  return <section className="plan-item-form" aria-label={`${ACCOUNT_LABELS[account.type]} account`}>
    <div className="plan-item-heading"><h3>{ACCOUNT_LABELS[account.type]} account</h3><button type="button" className="plan-remove" onClick={onRemove}>Remove</button></div>
    <div className="plan-fields">
      <SelectField label="Account type" value={draft.type} choices={["tfsa", "rrsp", "nonreg"] as const} labels={ACCOUNT_LABELS} onChange={type => change({ type, ...(type !== "nonreg" ? { bookValue: "" } : {}) })} />
      <TextInput label="Current balance ($)" value={draft.balance} min="0" onChange={balance => change({ balance })} />
      {draft.type === "nonreg" && <TextInput label="ACB / book value ($)" value={draft.bookValue} min="0" optional onChange={bookValue => change({ bookValue })} />}
      <TextInput label="Equity (%)" value={draft.equity} min="0" onChange={equity => change({ equity })} />
      <TextInput label="Bonds (%)" value={draft.bond} min="0" onChange={bond => change({ bond })} />
      <TextInput label="Cash (%)" value={draft.cash} min="0" onChange={cash => change({ cash })} />
    </div>
    <ErrorList errors={errors} />
    {errors.length > 0 ? <p className="draft-notice" role="status">These edits are not applied. Fix the errors to update the plan; the last valid account values are kept.</p>
      : applied ? <p className="plan-help" role="status">Changes applied automatically. Local saving status is shown above.</p>
      : <p className="plan-help">Valid account edits apply automatically.</p>}
  </section>;
}

const ASSET_KIND_LABELS: Record<AssetPlan["kind"], string> = { "primary-home": "Primary home", other: "Other" };
const SAVINGS_TARGET_LABELS: Record<SavingsTarget, string> = { tfsa: "TFSA", "rrsp-match": "RRSP (employer match)", rrsp: "RRSP", nonreg: "Non-registered", "mortgage-prepay": "Mortgage prepayment" };
interface AssetDraft { id: string; kind: AssetPlan["kind"]; name: string; value: string; appreciationRate: string; hasSale: boolean; saleAge: string; saleCosts: string }
function assetDraft(asset: AssetPlan): AssetDraft { return { id: asset.id, kind: asset.kind, name: asset.name, value: String(asset.value), appreciationRate: String(asset.appreciationRate * 100), hasSale: !!asset.sellEvent, saleAge: asset.sellEvent ? String(asset.sellEvent.age) : "", saleCosts: asset.sellEvent ? String(asset.sellEvent.costsPct * 100) : "" }; }
function newAssetDraft(): AssetDraft { return { id: makeId("asset"), kind: "primary-home", name: "", value: "0", appreciationRate: "2", hasSale: false, saleAge: "", saleCosts: "5" }; }
function AssetForm({ initial, isNew, onSave, onRemove, onCancel }: { initial: AssetDraft; isNew: boolean; onSave: (item: AssetPlan) => void; onRemove?: () => void; onCancel?: () => void }) {
  const [draft, setDraft] = useState(initial);
  const errors: string[] = [];
  const name = draft.name.trim(); if (!name) errors.push("Name this asset.");
  const value = requiredNumber(draft.value, "Value", errors, 0);
  const appreciationRate = requiredNumber(draft.appreciationRate, "Appreciation rate", errors) / 100;
  const saleAge = draft.hasSale ? requiredInteger(draft.saleAge, "Sale age", errors, 1) : undefined;
  const saleCostsPct = draft.hasSale ? requiredNumber(draft.saleCosts, "Sale costs", errors, 0) : undefined;
  if (saleCostsPct !== undefined && saleCostsPct > 100) errors.push("Sale costs cannot exceed 100%.");
  const saleCosts = saleCostsPct === undefined ? undefined : saleCostsPct / 100;
  const save = () => onSave({ id: draft.id, kind: draft.kind, name, value, appreciationRate, ...(saleAge === undefined ? {} : { sellEvent: { age: saleAge, costsPct: saleCosts ?? 0 } }) });
  return <ItemForm title={isNew ? "New asset" : draft.name || "Asset"} errors={errors} onSubmit={save} onRemove={onRemove} onCancel={onCancel} isNew={isNew}>
    <SelectField label="Asset kind" value={draft.kind} choices={["primary-home", "other"] as const} labels={ASSET_KIND_LABELS} onChange={kind => setDraft({ ...draft, kind })} />
    <TextField label="Name" value={draft.name} onChange={name => setDraft({ ...draft, name })} optional />
    <TextInput label="Current value ($)" value={draft.value} min="0" onChange={value => setDraft({ ...draft, value })} />
    <TextInput label="Annual appreciation (%)" value={draft.appreciationRate} onChange={appreciationRate => setDraft({ ...draft, appreciationRate })} />
    <label className="plan-check"><input type="checkbox" checked={draft.hasSale} onChange={event => setDraft({ ...draft, hasSale: event.currentTarget.checked })} />Plan a sale event</label>
    {draft.hasSale && <>
      <TextInput label="Sale age" value={draft.saleAge} min="1" step="1" onChange={saleAge => setDraft({ ...draft, saleAge })} />
      <TextInput label="Sale costs (%)" value={draft.saleCosts} min="0" onChange={saleCosts => setDraft({ ...draft, saleCosts })} />
    </>}
  </ItemForm>;
}

interface DebtDraft { id: string; rate: string; termYears: string; amortizationYears: string; balance: string; monthlyPayment: string }
function debtDraft(debt: DebtPlan): DebtDraft { return { id: debt.id, rate: String(debt.rate * 100), termYears: String(debt.termYears), amortizationYears: String(debt.amortizationYears), balance: String(debt.balance), monthlyPayment: String(debt.monthlyPayment) }; }
function newDebtDraft(): DebtDraft { return { id: makeId("mortgage"), rate: "4.5", termYears: "5", amortizationYears: "25", balance: "1", monthlyPayment: "1" }; }
function DebtForm({ initial, isNew, onSave, onRemove, onCancel }: { initial: DebtDraft; isNew: boolean; onSave: (item: DebtPlan) => void; onRemove?: () => void; onCancel?: () => void }) {
  const [draft, setDraft] = useState(initial);
  const errors: string[] = [];
  const rate = requiredNumber(draft.rate, "Interest rate", errors, 0) / 100;
  const termYears = requiredInteger(draft.termYears, "Term", errors, 1);
  const amortizationYears = requiredInteger(draft.amortizationYears, "Amortization", errors, 1);
  const balance = requiredNumber(draft.balance, "Balance", errors, 0);
  const monthlyPayment = requiredNumber(draft.monthlyPayment, "Monthly payment", errors, 0);
  if (balance <= 0) errors.push("Mortgage balance must be greater than $0.");
  if (monthlyPayment <= 0) errors.push("Monthly payment must be greater than $0.");
  const save = () => onSave({ id: draft.id, kind: "mortgage", rate, termYears, amortizationYears, balance, monthlyPayment });
  return <ItemForm title={isNew ? "New mortgage" : draft.id} errors={errors} onSubmit={save} onRemove={onRemove} onCancel={onCancel} isNew={isNew}>
    <TextInput label="Annual interest rate (%)" value={draft.rate} min="0" onChange={rate => setDraft({ ...draft, rate })} />
    <TextInput label="Mortgage balance ($)" value={draft.balance} min="0" onChange={balance => setDraft({ ...draft, balance })} />
    <TextInput label="Monthly payment ($)" value={draft.monthlyPayment} min="0" onChange={monthlyPayment => setDraft({ ...draft, monthlyPayment })} />
    <TextInput label="Term (years)" value={draft.termYears} min="1" step="1" onChange={termYears => setDraft({ ...draft, termYears })} />
    <TextInput label="Amortization (years)" value={draft.amortizationYears} min="1" step="1" onChange={amortizationYears => setDraft({ ...draft, amortizationYears })} />
  </ItemForm>;
}

interface IncomeDraft { id: string; kind: IncomePlan["kind"]; annualAmount: string; startAge: string; endAge: string; raiseRate: string }
function incomeDraft(income: IncomePlan): IncomeDraft { return { id: income.id, kind: income.kind, annualAmount: String(income.annualAmount), startAge: String(income.startAge), endAge: income.endAge === undefined ? "" : String(income.endAge), raiseRate: String(income.raiseRate * 100) }; }
function newIncomeDraft(kind: IncomePlan["kind"], currentAge: number, retirementAge: number): IncomeDraft { return { id: makeId("income"), kind, annualAmount: "0", startAge: String(currentAge), endAge: kind === "employment" ? String(Math.max(currentAge, retirementAge - 1)) : "", raiseRate: kind === "employment" ? "2" : "0" }; }
const INCOME_LABELS: Record<IncomePlan["kind"], string> = { employment: "Employment", cpp: "CPP", oas: "OAS", other: "Other" };
function IncomeForm({ initial, isNew, onSave, onRemove, onCancel }: { initial: IncomeDraft; isNew: boolean; onSave: (item: IncomePlan) => void; onRemove?: () => void; onCancel?: () => void }) {
  const [draft, setDraft] = useState(initial);
  const errors: string[] = [];
  const annualAmount = requiredNumber(draft.annualAmount, "Annual amount", errors, 0);
  const startAge = requiredInteger(draft.startAge, "Start age", errors, 1);
  const endAge = optionalInteger(draft.endAge, "End age", errors, 1);
  const raiseRate = requiredNumber(draft.raiseRate, "Annual raise (%)", errors) / 100;
  if (endAge !== undefined && endAge < startAge) errors.push("End age must be on or after start age.");
  const save = () => onSave({ id: draft.id, kind: draft.kind, annualAmount, startAge, ...(endAge === undefined ? {} : { endAge }), raiseRate });
  return <ItemForm title={isNew ? "New income" : draft.kind} errors={errors} onSubmit={save} onRemove={onRemove} onCancel={onCancel} isNew={isNew}>
    <SelectField label="Income type" value={draft.kind} choices={["employment", "cpp", "oas", "other"] as const} labels={INCOME_LABELS} onChange={kind => setDraft({ ...draft, kind, endAge: kind === "employment" ? draft.endAge : "" })} />
    <TextInput label="Annual amount ($)" value={draft.annualAmount} min="0" onChange={annualAmount => setDraft({ ...draft, annualAmount })} />
    <TextInput label="Start age" value={draft.startAge} min="1" step="1" onChange={startAge => setDraft({ ...draft, startAge })} />
    <TextInput label="End age" value={draft.endAge} min="1" step="1" optional onChange={endAge => setDraft({ ...draft, endAge })} />
    <TextInput label="Annual raise / indexing (%)" value={draft.raiseRate} onChange={raiseRate => setDraft({ ...draft, raiseRate })} />
  </ItemForm>;
}

interface ExpenseDraft { id: string; name: string; annualAmount: string; startAge: string; endAge: string; inflationRate: string }
function expenseDraft(expense: ExpensePlan): ExpenseDraft { return { id: expense.id, name: expense.name, annualAmount: String(expense.annualAmount), startAge: String(expense.startAge), endAge: expense.endAge === undefined ? "" : String(expense.endAge), inflationRate: String(expense.inflationRate * 100) }; }
function newExpenseDraft(currentAge: number): ExpenseDraft { return { id: makeId("expense"), name: "", annualAmount: "0", startAge: String(currentAge), endAge: "", inflationRate: "2" }; }
function ExpenseForm({ initial, isNew, onSave, onRemove, onCancel }: { initial: ExpenseDraft; isNew: boolean; onSave: (item: ExpensePlan) => void; onRemove?: () => void; onCancel?: () => void }) {
  const [draft, setDraft] = useState(initial);
  const errors: string[] = [];
  const name = draft.name.trim(); if (!name) errors.push("Name this expense.");
  const annualAmount = requiredNumber(draft.annualAmount, "Annual amount", errors, 0);
  const startAge = requiredInteger(draft.startAge, "Start age", errors, 1);
  const endAge = optionalInteger(draft.endAge, "End age", errors, 1);
  const inflationRate = requiredNumber(draft.inflationRate, "Annual inflation (%)", errors) / 100;
  if (endAge !== undefined && endAge < startAge) errors.push("End age must be on or after start age.");
  const save = () => onSave({ id: draft.id, name, annualAmount, startAge, ...(endAge === undefined ? {} : { endAge }), inflationRate });
  return <ItemForm title={isNew ? "New expense" : draft.name || "Expense"} errors={errors} onSubmit={save} onRemove={onRemove} onCancel={onCancel} isNew={isNew}>
    <TextField label="Name" value={draft.name} onChange={name => setDraft({ ...draft, name })} optional />
    <TextInput label="Annual amount ($)" value={draft.annualAmount} min="0" onChange={annualAmount => setDraft({ ...draft, annualAmount })} />
    <TextInput label="Start age" value={draft.startAge} min="1" step="1" onChange={startAge => setDraft({ ...draft, startAge })} />
    <TextInput label="End age" value={draft.endAge} min="1" step="1" optional onChange={endAge => setDraft({ ...draft, endAge })} />
    <TextInput label="Annual inflation (%)" value={draft.inflationRate} onChange={inflationRate => setDraft({ ...draft, inflationRate })} />
  </ItemForm>;
}

interface SavingsDraft { id: string; priority: string; target: SavingsTarget; perYearCap: string; untilAge: string; matchRate: string }
function savingsDraft(step: SavingsPolicyStep): SavingsDraft { return { id: step.id, priority: String(step.priority), target: step.target, perYearCap: step.perYearCap === undefined ? "" : String(step.perYearCap), untilAge: step.untilAge === undefined ? "" : String(step.untilAge), matchRate: step.matchRate === undefined ? "5" : String(step.matchRate * 100) }; }
function newSavingsDraft(priority: number): SavingsDraft { return { id: makeId("saving"), priority: String(priority), target: "tfsa", perYearCap: "", untilAge: "", matchRate: "5" }; }
function SavingsForm({ initial, isNew, onSave, onRemove, onCancel }: { initial: SavingsDraft; isNew: boolean; onSave: (item: SavingsPolicyStep) => void; onRemove?: () => void; onCancel?: () => void }) {
  const [draft, setDraft] = useState(initial);
  const errors: string[] = [];
  const priority = requiredNumber(draft.priority, "Priority", errors, 1);
  const perYearCap = optionalNumber(draft.perYearCap, "Annual cap", errors, 0);
  const untilAge = optionalInteger(draft.untilAge, "Until age", errors, 1);
  const matchRate = draft.target === "rrsp-match" ? requiredNumber(draft.matchRate, "Employer match (%)", errors, 0) / 100 : undefined;
  if (matchRate !== undefined && matchRate > 1) errors.push("Employer match must be between 0% and 100%.");
  const save = () => onSave({ id: draft.id, priority, target: draft.target, ...(perYearCap === undefined ? {} : { perYearCap }), ...(untilAge === undefined ? {} : { untilAge }), ...(matchRate === undefined ? {} : { matchRate }) });
  return <ItemForm title={isNew ? "New savings step" : `Priority ${draft.priority}`} errors={errors} onSubmit={save} onRemove={onRemove} onCancel={onCancel} isNew={isNew}>
    <TextInput label="Priority" value={draft.priority} min="1" onChange={priority => setDraft({ ...draft, priority })} />
    <SelectField label="Savings target" value={draft.target} choices={["tfsa", "rrsp-match", "rrsp", "nonreg", "mortgage-prepay"] as const} labels={SAVINGS_TARGET_LABELS} onChange={target => setDraft({ ...draft, target })} />
    <TextInput label="Annual cap ($)" value={draft.perYearCap} min="0" optional onChange={perYearCap => setDraft({ ...draft, perYearCap })} />
      <TextInput label="Active through age" value={draft.untilAge} min="1" step="1" optional onChange={untilAge => setDraft({ ...draft, untilAge })} />
    {draft.target === "rrsp-match" && <TextInput label="Employer match (%)" value={draft.matchRate} min="0" onChange={matchRate => setDraft({ ...draft, matchRate })} />}
  </ItemForm>;
}

function ProfileEditor() {
  const { workspace, dispatch, baseScenario, validationErrors, runProjection, runError, calendarYear } = useWorkspace();
  const profile = workspace.plan.profile;
  const [birthYear, setBirthYear] = useState(String(profile.birthYear));
  const [endAge, setEndAge] = useState(String(profile.endAge));
  const [errors, setErrors] = useState<string[]>([]);
  useEffect(() => {
    setBirthYear(String(profile.birthYear));
    setEndAge(String(profile.endAge));
  }, [profile.birthYear, profile.endAge]);
  const previewAge = birthYear.trim() !== "" && Number.isInteger(Number(birthYear)) ? calculateCurrentAge(Number(birthYear), calendarYear) : null;
  const dirty = birthYear !== String(profile.birthYear) || endAge !== String(profile.endAge);
  const save = (event: FormEvent) => {
    event.preventDefault();
    const nextErrors: string[] = [];
    const birth = requiredInteger(birthYear, "Birth year", nextErrors, 1);
    const age = calculateCurrentAge(birth, calendarYear);
    if (age <= 0) nextErrors.push(`Birth year must be before ${calendarYear}.`);
    const end = requiredInteger(endAge, "Projection end age", nextErrors, 1);
    if (end <= age) nextErrors.push("Projection end age must be greater than current age.");
    setErrors(nextErrors);
    if (nextErrors.length) return;
    dispatch({ type: "plan/setProfile", patch: { birthYear: birth, endAge: end } });
  };
  return <section className="plan-panel" aria-labelledby="profile-title">
    <h2 id="profile-title">Profile and projection</h2>
    <p className="plan-help">Set the starting point and the last age to project. Province is Ontario in this version.</p>
    <form noValidate onSubmit={save}>
      <div className="plan-fields">
        <TextInput label="Birth year" value={birthYear} min="1" step="1" onChange={value => { setBirthYear(value); setErrors([]); }} />
        <label className="plan-field"><span className="field-label">Current age</span><input type="number" aria-label="Current age" readOnly value={previewAge !== null && previewAge > 0 ? previewAge : ""} aria-describedby="current-age-help" /><small id="current-age-help">Age reached in {calendarYear}, calculated from birth year.</small></label>
        <TextInput label="Projection end age" value={endAge} min="1" step="1" onChange={value => { setEndAge(value); setErrors([]); }} />
        <label className="plan-field"><span className="field-label">Province</span><select value="ON" disabled><option value="ON">Ontario (ON)</option></select></label>
        <label className="plan-field"><span className="field-label">Retirement age</span><input type="number" aria-label="Retirement age" readOnly value={baseScenario.retirementAge} /><small>Change this in Base projection settings.</small></label>
      </div>
      <ErrorList errors={errors} />
      {dirty && <p className="draft-notice" role="status">Unsaved profile edits. Save profile to apply them.</p>}
      <div className="plan-actions"><button className="primary" type="submit">Save profile</button>
        <button type="button" disabled={dirty || validationErrors.length > 0} onClick={() => runProjection()}>Run projection</button></div>
    </form>
    {validationErrors.length > 0 && <div className="plan-errors" role="alert" aria-label="Plan validation errors"><strong>Plan needs attention</strong>{validationErrors.map(error => <p key={error}>{error}</p>)}</div>}
    {runError && <p role="alert" className="plan-errors">{runError}</p>}
  </section>;
}

function AccountsEditor() {
  const { workspace, dispatch } = useWorkspace(); const items = workspace.plan.accounts;
  const add = () => dispatch({ type: "plan/addItem", section: "accounts", item: { id: makeId("account"), type: "tfsa", balance: 0, assetMix: { equity: 0.6, bond: 0.3, cash: 0.1 } } });
  return <section className="plan-panel"><div className="plan-section-heading"><div><h2>Accounts</h2><p>Balances, registered account type, and investment mix. Valid edits apply automatically.</p></div><button type="button" onClick={add}>Add account</button></div>
    {items.map(item => <AccountForm key={item.id} account={item} onApply={value => dispatch({ type: "plan/updateItem", section: "accounts", id: item.id, patch: value })} onRemove={() => dispatch({ type: "plan/removeItem", section: "accounts", id: item.id })} />)}
    {!items.length && <p className="plan-empty">No accounts yet. Add a TFSA, RRSP, or non-registered account.</p>}
  </section>;
}

function AssetsDebtsEditor() {
  const { workspace, dispatch } = useWorkspace(); const { assets, debts } = workspace.plan;
  const [addingAsset, setAddingAsset] = useState(false); const [addingDebt, setAddingDebt] = useState(false);
  const saveAsset = (item: AssetPlan, isNew: boolean) => { dispatch(isNew ? { type: "plan/addItem", section: "assets", item } : { type: "plan/updateItem", section: "assets", id: item.id, patch: item }); setAddingAsset(false); };
  const saveDebt = (item: DebtPlan, isNew: boolean) => { dispatch(isNew ? { type: "plan/addItem", section: "debts", item } : { type: "plan/updateItem", section: "debts", id: item.id, patch: item }); setAddingDebt(false); };
  return <section className="plan-panel">
    <div className="plan-section-heading"><div><h2>Assets</h2><p>Homes and other assets, including optional sale events.</p></div><button type="button" onClick={() => setAddingAsset(true)} disabled={addingAsset}>Add asset</button></div>
    {assets.map(item => <AssetForm key={item.id} initial={assetDraft(item)} isNew={false} onSave={value => saveAsset(value, false)} onRemove={() => dispatch({ type: "plan/removeItem", section: "assets", id: item.id })} />)}
    {addingAsset && <AssetForm initial={newAssetDraft()} isNew onSave={value => saveAsset(value, true)} onCancel={() => setAddingAsset(false)} />}
    {!assets.length && !addingAsset && <p className="plan-empty">No assets yet.</p>}
    <div className="plan-section-heading plan-subsection"><div><h2>Debts</h2><p>Mortgage rate, term, amortization, and payment.</p></div><button type="button" onClick={() => setAddingDebt(true)} disabled={addingDebt || debts.length > 0}>Add mortgage</button></div>
    {debts.map(item => <DebtForm key={item.id} initial={debtDraft(item)} isNew={false} onSave={value => saveDebt(value, false)} onRemove={() => dispatch({ type: "plan/removeItem", section: "debts", id: item.id })} />)}
    {addingDebt && <DebtForm initial={newDebtDraft()} isNew onSave={value => saveDebt(value, true)} onCancel={() => setAddingDebt(false)} />}
    {!debts.length && !addingDebt && <p className="plan-empty">No mortgage added.</p>}
  </section>;
}

function IncomesEditor() {
  const { workspace, dispatch, baseScenario } = useWorkspace(); const items = workspace.plan.incomes;
  const [adding, setAdding] = useState<IncomePlan["kind"] | null>(null);
  const save = (item: IncomePlan, isNew: boolean) => { dispatch(isNew ? { type: "plan/addItem", section: "incomes", item } : { type: "plan/updateItem", section: "incomes", id: item.id, patch: item }); setAdding(null); };
  return <section className="plan-panel"><div className="plan-section-heading"><div><h2>Income</h2><p>Enter taxable income and the ages when each stream starts and ends. End age is optional.</p></div>
    <div className="plan-add-buttons">{(["employment", "cpp", "oas", "other"] as const).map(kind => <button key={kind} type="button" onClick={() => setAdding(kind)} disabled={adding !== null}>Add {kind}</button>)}</div></div>
    {items.map(item => <IncomeForm key={item.id} initial={incomeDraft(item)} isNew={false} onSave={value => save(value, false)} onRemove={() => dispatch({ type: "plan/removeItem", section: "incomes", id: item.id })} />)}
    {adding && <IncomeForm initial={newIncomeDraft(adding, workspace.plan.profile.currentAge, baseScenario.retirementAge)} isNew onSave={value => save(value, true)} onCancel={() => setAdding(null)} />}
    {!items.length && !adding && <p className="plan-empty">No income streams yet.</p>}
  </section>;
}

function ExpensesEditor() {
  const { workspace, dispatch } = useWorkspace(); const items = workspace.plan.expenses;
  const [adding, setAdding] = useState(false);
  const save = (item: ExpensePlan, isNew: boolean) => { dispatch(isNew ? { type: "plan/addItem", section: "expenses", item } : { type: "plan/updateItem", section: "expenses", id: item.id, patch: item }); setAdding(false); };
  return <section className="plan-panel"><div className="plan-section-heading"><div><h2>Expenses</h2><p>Annual spending, active years, and the inflation rate.</p></div><button type="button" onClick={() => setAdding(true)} disabled={adding}>Add expense</button></div>
    {items.map(item => <ExpenseForm key={item.id} initial={expenseDraft(item)} isNew={false} onSave={value => save(value, false)} onRemove={() => dispatch({ type: "plan/removeItem", section: "expenses", id: item.id })} />)}
    {adding && <ExpenseForm initial={newExpenseDraft(workspace.plan.profile.currentAge)} isNew onSave={value => save(value, true)} onCancel={() => setAdding(false)} />}
    {!items.length && !adding && <p className="plan-empty">No expenses yet.</p>}
  </section>;
}

function SavingsEditor() {
  const { workspace, dispatch } = useWorkspace(); const items = workspace.plan.savingsPolicy;
  const [adding, setAdding] = useState(false);
  const save = (item: SavingsPolicyStep, isNew: boolean) => { dispatch(isNew ? { type: "plan/addItem", section: "savingsPolicy", item } : { type: "plan/updateItem", section: "savingsPolicy", id: item.id, patch: item }); setAdding(false); };
  return <section className="plan-panel"><div className="plan-section-heading"><div><h2>Savings policy</h2><p>Order savings steps by priority. A TFSA/RRSP contribution uses available room.</p></div><button type="button" onClick={() => setAdding(true)} disabled={adding}>Add savings step</button></div>
    {items.map(item => <SavingsForm key={item.id} initial={savingsDraft(item)} isNew={false} onSave={value => save(value, false)} onRemove={() => dispatch({ type: "plan/removeItem", section: "savingsPolicy", id: item.id })} />)}
    {adding && <SavingsForm initial={newSavingsDraft(items.length + 1)} isNew onSave={value => save(value, true)} onCancel={() => setAdding(false)} />}
    {!items.length && !adding && <p className="plan-empty">No savings steps yet. Unallocated surplus goes to non-registered savings when available.</p>}
  </section>;
}

/** Full plan editor; mounted by the app shell at the Plan route. */
export function PlanView() {
  const { clearEditNotice } = useWorkspace();
  const [activeTab, setActiveTab] = useState<Tab>("Profile");
  return <div className="plan-view" onChangeCapture={clearEditNotice}>
    <div className="plan-view-header"><div><span className="eyebrow">YOUR FINANCIAL PICTURE</span><h1>Plan</h1><p className="plan-help">Edit your starting profile, accounts, income, spending, and savings rules.</p></div></div>
    <div className="plan-tabs" role="tablist" aria-label="Plan sections">
      {TABS.map(tab => <button key={tab} type="button" role="tab" id={`plan-tab-${tab.replaceAll(" ", "-").toLowerCase()}`} aria-selected={activeTab === tab} aria-controls="plan-tabpanel" onClick={() => setActiveTab(tab)}>{tab}</button>)}
    </div>
    <div role="tabpanel" id="plan-tabpanel" aria-labelledby={`plan-tab-${activeTab.replaceAll(" ", "-").toLowerCase()}`}>
      {activeTab === "Profile" && <ProfileEditor />}
      {activeTab === "Accounts" && <AccountsEditor />}
      {activeTab === "Assets & debts" && <AssetsDebtsEditor />}
      {activeTab === "Income" && <IncomesEditor />}
      {activeTab === "Expenses" && <ExpensesEditor />}
      {activeTab === "Savings" && <SavingsEditor />}
    </div>
  </div>;
}
